# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project URL and public publishable/anon key.
# Never use a service_role or secret key in this frontend project.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Vite-exposed aliases used by the browser eligibility check.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Backend relayer endpoint, expected to expose POST /vote.
VITE_RELAYER_URL="http://localhost:3001"
# RPC used only by the direct wallet fallback.
VITE_RPC_URL="http://127.0.0.1:8545"
VITE_HARDHAT_RPC_URL="http://127.0.0.1:8545"
VITE_WEB3AUTH_CLIENT_ID="your-web3auth-client-id"
VITE_API_URL="http://localhost:3001"
# Backend-only secrets and Web3Auth verification settings.
API_PORT="3001"
FRONTEND_ORIGIN="http://localhost:3000"
WEB3AUTH_ISSUER="https://api-auth.web3auth.io"
WEB3AUTH_CLIENT_ID="your-web3auth-client-id"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
RPC_URL="http://127.0.0.1:8545"
REGISTRAR_PRIVATE_KEY="server-only-registrar-private-key"
RELAYER_PRIVATE_KEY="server-only-relayer-private-key"
SEMAPHORE_ADDRESS="deployed-semaphore-address"
ADMIN_EMAILS="admin@univ-saffra.edu"
REGISTRATION_BATCH_SIZE="5"
REGISTRATION_BATCH_INTERVAL_MS="30000"
# Optional: replace * with a comma-separated list of columns.
# ETUDIANTS_COLUMNS="id,nom,email"
